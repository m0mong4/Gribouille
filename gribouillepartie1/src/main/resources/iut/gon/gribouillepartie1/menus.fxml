<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioMenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.ToggleGroup?>

<MenuBar xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="iut.gon.gribouillepartie1.controleurs.MenusController">
    <menus>
        <Menu mnemonicParsing="false" text="Dessin">
            <items>
                <MenuItem mnemonicParsing="false" text="Charger" />
                <MenuItem mnemonicParsing="false" text="Sauvegarder" />
                <MenuItem mnemonicParsing="false" text="Exporter" />
                <SeparatorMenuItem mnemonicParsing="false" />
                <MenuItem mnemonicParsing="false" text="Quitter" onAction="#onQuitte" />
            </items>
        </Menu>
        <Menu mnemonicParsing="false" text="Outils">
            <items>
                <Menu mnemonicParsing="false" text="Epaisseur">
                    <items>
                        <RadioMenuItem mnemonicParsing="false" text="1">
                            <toggleGroup>
                                <ToggleGroup fx:id="choixepaisseur" />
                            </toggleGroup>
                        </RadioMenuItem>
                        <RadioMenuItem mnemonicParsing="false" text="2" toggleGroup="$choixepaisseur" />
                        <RadioMenuItem mnemonicParsing="false" text="3" toggleGroup="$choixepaisseur" />
                        <RadioMenuItem mnemonicParsing="false" text="4" toggleGroup="$choixepaisseur" />
                        <RadioMenuItem mnemonicParsing="false" text="5" toggleGroup="$choixepaisseur" />
                        <RadioMenuItem mnemonicParsing="false" text="6" toggleGroup="$choixepaisseur" />
                        <RadioMenuItem mnemonicParsing="false" text="7" toggleGroup="$choixepaisseur" />
                        <RadioMenuItem mnemonicParsing="false" text="8" toggleGroup="$choixepaisseur" />
                        <RadioMenuItem mnemonicParsing="false" text="9" toggleGroup="$choixepaisseur" />
                    </items>
                </Menu>
                <RadioMenuItem fx:id="menuCrayon" mnemonicParsing="false" text="Crayon">
                    <toggleGroup>
                        <ToggleGroup fx:id="choixstylo" />
                    </toggleGroup>
                </RadioMenuItem>
                <RadioMenuItem fx:id="menuEtoile" mnemonicParsing="false" text="Etoile" toggleGroup="$choixstylo" />
            </items>
        </Menu>
        <Menu mnemonicParsing="false" text="Aide">
            <items>
                <MenuItem mnemonicParsing="false" text="A propos" />
            </items>
        </Menu>
    </menus>
</MenuBar>
