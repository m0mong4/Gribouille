<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="iut.gon.gribouillepartie1.controleurs.StatutController">
    <columnConstraints>
        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
    </rowConstraints>
    <children>
        <HBox prefHeight="100.0" prefWidth="200.0">
            <children>
                <Label text="X: ">
                    <HBox.margin><Insets top="5.0" /></HBox.margin>
                </Label>
                <Label fx:id="abscisse" text="0">
                    <HBox.margin><Insets top="5.0" /></HBox.margin>
                </Label>
            </children>
        </HBox>
        <HBox prefHeight="100.0" prefWidth="200.0" GridPane.columnIndex="1">
            <children>
                <Label text="Y:">
                    <HBox.margin><Insets top="5.0" /></HBox.margin>
                </Label>
                <Label fx:id="ordonnee" text=" 0">
                    <HBox.margin><Insets top="5.0" /></HBox.margin>
                </Label>
            </children>
        </HBox>
        <HBox prefHeight="100.0" prefWidth="200.0" GridPane.columnIndex="2">
            <children>
                <Label text="Epaisseur : ">
                    <HBox.margin><Insets top="5.0" /></HBox.margin>
                </Label>
                <Label fx:id="epais" text=" 3">
                    <HBox.margin><Insets top="5.0" /></HBox.margin>
                </Label>
            </children>
        </HBox>
        <Label fx:id="outil" text="Outils" GridPane.columnIndex="3">
            <padding><Insets bottom="2.0" /></padding>
        </Label>
        <Label fx:id="couleurLabel" text="Couleur" GridPane.columnIndex="4">
            <padding><Insets bottom="2.0" /></padding>
        </Label>
    </children>
</GridPane>
